# Zeigt den SmartMirror nach dem Booten im Vollbild auf dem Display.
#
# Vorlage: die Platzhalter setzt deploy/setup.sh ein. Welcher Browser läuft
# und wie das Bild gedreht ist, steht nicht hier, sondern in
#
#     /etc/default/smartmirror-kiosk
#
# Nach einer Änderung dort genügt:
#
#     sudo systemctl restart smartmirror-kiosk

[Unit]
Description=SmartMirror Kiosk
After=systemd-user-sessions.service network-online.target nginx.service
Wants=network-online.target

# Der Kiosk übernimmt tty1. Die Login-Konsole dort würde sich sonst mit
# ihm um den Bildschirm streiten.
Conflicts=getty@tty1.service
After=getty@tty1.service

# Startet der Browser auf dieser Hardware gar nicht, nicht endlos neu
# versuchen - auf einem Kern würde das den ganzen Pi lahmlegen. Ein
# gelegentlicher Absturz im Dauerbetrieb liegt weit unter dieser Grenze.
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Type=simple

User=__USER__
SupplementaryGroups=video render input

# Eine echte Sitzung auf seat0 und tty1. Erst dadurch geben systemd-logind
# und udev dem Kiosk Bildschirm und Eingabegeräte frei.
PAMName=smartmirror-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

Environment=XDG_RUNTIME_DIR=/run/user/__UID__

# Ohne das bricht cage ab, wenn weder Maus noch Tastatur angeschlossen
# sind - beim Spiegel also im Normalbetrieb.
Environment=WLR_LIBINPUT_NO_DEVICES=1

EnvironmentFile=-/etc/default/smartmirror-kiosk

ExecStart=__PROJECT_DIR__/deploy/kiosk.sh

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
